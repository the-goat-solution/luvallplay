<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing the app keeps on this phone leaves it,
     neither in Google's cloud backup nor in a transfer to a new phone
     (which ignores allowBackup="false"). Every domain is excluded in full:
     the app's folder, files, databases, preferences, external files, and
     the device-protected copies of each. A person signs in again on a new
     phone; the session token is in the Keystore and couldn't be read there
     anyway. Checked by tests/shell.test.ts. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
