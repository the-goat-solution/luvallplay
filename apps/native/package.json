{
  "name": "native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Luvallplay store apps: a Capacitor shell around the players' app (apps/app), bundled, not a remote website.",
  "scripts": {
    "web": "node scripts/build-web.mjs",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "google-services": "node scripts/write-google-services.mjs",
    "release:check": "node scripts/check-release.mjs",
    "play:upload": "node scripts/play-upload.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "capacitor-secure-storage-plugin": "^0.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
