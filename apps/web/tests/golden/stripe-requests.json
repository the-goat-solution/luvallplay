  "one-time membership: new customer": {
    "calls": [
      {
        "call": "customers.list",
        "args": [
          {
            "email": "ana@example.test",
            "limit": 1
          }
        ]
      },
      {
        "call": "customers.create",
        "args": [
          {
            "email": "ana@example.test",
            "name": "Ana Ngata",
            "phone": "+64211234567",
            "metadata": {
              "plan": "monthly",
              "day": "friday"
            }
          }
        ]
      },
      {
        "call": "paymentIntents.create",
        "args": [
          {
            "amount": 3300,
            "currency": "nzd",
            "customer": "cus_new",
            "automatic_payment_methods": {
              "enabled": true
            },
            "receipt_email": "ana@example.test",
            "description": "Three Wolves — Monthly Membership (Friday) — one-time",
            "metadata": {
              "type": "membership",
              "plan": "monthly",
              "day": "friday",
              "recurring": "false",
              "firstName": "Ana",
              "lastName": "Ngata",
              "email": "ana@example.test",
              "phone": "+64211234567"
            }
          },
          {
            "idempotencyKey": "membership-onetime-monthly-ana@example.test-<now>"
          }
        ]
      }
    ],
    "outcome": {
      "result": {
        "id": "pi_1",
        "client_secret": "pi_1_secret"
      }
    }
  },
