{
  "name": "luvallplay",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "pnpm --filter web dev",
    "e2e": "pnpm --filter web e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next": "16"
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
