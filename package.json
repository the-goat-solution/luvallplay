    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.99.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.1",
    "@vercel/blob": "^2.8.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.0.2",
    "jsqr": "^1.4.0",
    "next": "^15.3.3",
    "next-sanity": "^9.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.22.0",
    "sanity": "^3.99.0",
    "stripe": "^18.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vercel/postgres": "^0.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "pg": "^8.23.1",
    "typescript": "^5.8.3"
  }
