{
  "name": "three-wolves-badminton",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-mediapipe.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-mediapipe.mjs && node scripts/db/preview-migrate.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/db/migrate.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "data-guard": "node scripts/data-guard/cli.ts",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "e2e": "E2E_BUILD=1 npm run build && node --test --test-concurrency=1 --test-timeout=240000 tests/e2e/journeys.mjs",
    "db:drift": "node scripts/db/migrate.mjs --drift",
    "db:dump": "node scripts/schema-dump.mjs",
    "db:seed": "node scripts/db/seed.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@neondatabase/serverless": "^1.2.1",
