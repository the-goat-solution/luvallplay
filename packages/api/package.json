{
  "name": "@luvallplay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The typed API contract for the players' app (zod) and the client generated from it. No I/O beyond fetch in the client.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./schemas": "./src/schemas.ts",
    "./shape": "./src/shape.ts",
    "./client": "./src/client.ts",
    "./client.gen": "./src/client.gen.ts",
    "./routes": "./src/routes.gen.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.ts",
    "snapshot": "node scripts/snapshot.ts"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5"
  }
}
