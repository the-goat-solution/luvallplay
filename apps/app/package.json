{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Luvallplay players' app: a client-side app on the typed API (packages/api), built to static files.",
  "scripts": {
    "predev": "node ../../packages/vision/scripts/copy-mediapipe.mjs public",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "budget": "node scripts/check-budget.mjs",
    "e2e": "node --test --test-concurrency=1 --test-timeout=240000 tests/e2e/app.mjs",
    "prebuild": "node ../../packages/vision/scripts/copy-mediapipe.mjs public"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@luvallplay/api": "workspace:*",
    "@luvallplay/core": "workspace:*",
    "@luvallplay/i18n": "workspace:*",
    "@luvallplay/ui": "workspace:*",
    "@luvallplay/vision": "workspace:*",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@vercel/blob": "^2.8.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.10.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  }
}
