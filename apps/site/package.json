{
  "name": "site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Luvallplay's public website (luvallplay.com): English and Vietnamese, static with Sanity content.",
  "scripts": {
    "gen": "node scripts/build-seed.ts",
    "dev": "pnpm gen && next dev -p 3100",
    "build": "pnpm gen && node scripts/migrate.mjs --if-configured && next build",
    "start": "next start -p 3100",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && node --import ./tests/register.mjs --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "sanity:seed": "pnpm gen && node scripts/seed-sanity.ts",
    "e2e": "node --test --test-concurrency=1 --test-timeout=300000 tests/e2e/*.e2e.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "axe-core": "^4.10.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.8.3"
  }
}
