<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs, through Firebase). Xcode switches this to "production" when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Links to https://app.luvallplay.com open the app (apple-app-site-association is served by apps/app). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.luvallplay.com</string>
	</array>
</dict>
</plist>
