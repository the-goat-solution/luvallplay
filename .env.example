# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRODUCT_DONATION=prod_...

# Vercel Postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Sanity webhook (API → Webhooks): POST https://your-domain.com/api/revalidate
# Set the same secret in Sanity webhook settings (not as a query param).
SANITY_REVALIDATE_SECRET=

# Optional: Cloudflare Turnstile (bot protection on booking)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Play day roster email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
CLUB_ROSTER_EMAIL=threewolvesbadminton@gmail.com
# Set by Vercel Cron automatically when configured in vercel.json; also required to authorize manual calls to /api/cron/send-roster
CRON_SECRET=

# Admin roster page (/admin/play-days, /admin/members) — password-only login at /admin/login
ADMIN_PASSWORD=

# Signs the emailed self-service cancellation link (/cancel-membership) —
# any long random string
CANCEL_LINK_SECRET=

# Optional
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/YOUR_ID/review

# Resend (transactional email for admin headcount alerts)
RESEND_API_KEY=
ALERT_ADMIN_EMAILS=owner@example.com
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Google Calendar (service account, read-only — share the calendar with this
# service account's email; it becomes the source of truth for bookable dates)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Vercel Cron auth (Vercel sends this automatically as a Bearer header
# for its own cron invocations when this is set)
CRON_SECRET=
